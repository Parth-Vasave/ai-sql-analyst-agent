# Secrets
.env
.env.*
!.env.example

# Data: raw downloads are never committed; see data/README.md
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node
node_modules/
*.tsbuildinfo
dist/
.vercel/

# Editors / OS
.idea/
.vscode/
.DS_Store

# Impeccable design tooling: local-only working state, not committed (PRODUCT.md and DESIGN.md
# carry the durable project/design context instead)
.impeccable/

# Third-party Claude Code skills/agents installed locally (not part of this project)
.claude/skills/
.claude/agents/
