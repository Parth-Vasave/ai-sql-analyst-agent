# Copy to .env and fill in. Never commit .env.

# --- Postgres (owner account: schema setup and data loading only) ---
POSTGRES_USER=emissions_owner
POSTGRES_PASSWORD=change-me
POSTGRES_DB=emissions

# --- Read-only agent account (the only account the API uses) ---
SQL_AGENT_PASSWORD=change-me-too
# Set automatically by docker-compose for the backend container. For running the
# backend outside Docker:
DATABASE_URL=postgresql://sql_agent:change-me-too@localhost:5432/emissions
# Optional: several databases, see databases.example.toml (overrides DATABASE_URL).
DATABASES_CONFIG=
# Allow adding databases from the UI. LOCAL / SELF-HOSTED USE ONLY: never enable on a
# public deployment, it lets any visitor make the server connect to arbitrary hosts.
ALLOW_UI_CONNECTIONS=false
# For scripts/seed_database.py outside Docker:
ADMIN_DATABASE_URL=postgresql://emissions_owner:change-me@localhost:5432/emissions

# --- Query guardrails ---
QUERY_TIMEOUT_SECONDS=5
MAX_RETRIES=2
MAX_ROWS=1000

# --- LLM (any OpenAI-compatible endpoint) ---
# Google Gemini free tier (key: https://aistudio.google.com/apikey):
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
# Groq free tier (key: https://console.groq.com/keys):
#   LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile
